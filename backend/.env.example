# Copy this file to .env and add your Google AI Studio API key.
GEMINI_API_KEY=your_google_ai_studio_key
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSION=3072

# Security: generate a unique secret before deploying.
JWT_SECRET=replace-with-a-long-random-secret
JWT_TTL_HOURS=12

# Local paths and upload limits.
DATA_DIR=./data
DATABASE_PATH=./data/enterprise_brain.db
MAX_UPLOAD_MB=20
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
